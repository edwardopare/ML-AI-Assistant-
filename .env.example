# RAG AI — Environment Variables
#
# Copy this file to .env and fill in real values.
# Lines beginning with # are comments.  Remove them before sharing .env files.

# ---------------------------------------------------------------------------
# Deployment profile: "dev" or "prod"
# - dev:  auth disabled, human-readable console logging
# - prod: auth enforced, JSON-structured logging required
# ---------------------------------------------------------------------------
APP_ENV=dev

# ---------------------------------------------------------------------------
# OpenRouter LLM gateway
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_MAX_RETRIES=3
OPENROUTER_MAX_TOKENS=800
OPENROUTER_TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# Security — API authentication
# Leave API_KEY empty to disable authentication (dev only).
# ---------------------------------------------------------------------------
API_KEY=

# Microsoft Teams outgoing-webhook HMAC secret (base64-encoded).
# Leave empty to skip Teams signature verification (dev only).
TEAMS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Network security
# ---------------------------------------------------------------------------
# Comma-separated allowed CORS origins. Empty = no CORS headers added.
# Example: https://myapp.example.com,https://localhost:3000
CORS_ORIGINS=

# Comma-separated allowed Host header values. Empty = any host accepted.
# Example: api.myapp.com,localhost
API_ALLOWED_HOSTS=

# Maximum HTTP request body size in bytes (default 64 KB).
MAX_REQUEST_BODY_BYTES=65536

# Maximum API requests per minute per IP address.
RATE_LIMIT_PER_MINUTE=30

# Optional bearer token to gate the /metrics endpoint.
METRICS_TOKEN=

# ---------------------------------------------------------------------------
# Retrieval settings
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=4
RETRIEVAL_CANDIDATE_K=12
RETRIEVAL_MIN_SCORE=0.25
RETRIEVAL_DENSE_WEIGHT=0.7
RETRIEVAL_MMR_LAMBDA=0.75
MAX_CONTEXT_CHARS=12000

# ---------------------------------------------------------------------------
# Text chunking
# ---------------------------------------------------------------------------
TEXT_CHUNK_SIZE=1200
TEXT_CHUNK_OVERLAP=200

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
ENABLE_OCR=false

# ---------------------------------------------------------------------------
# Conversation memory
# ---------------------------------------------------------------------------
CONVERSATION_HISTORY_MESSAGES=10
CONVERSATION_MAX_AGE_DAYS=30
