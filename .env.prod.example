# Production profile template — fill in secrets before deploying
# Rename to .env (never commit with real secrets)
APP_ENV=prod
API_KEY=CHANGE_ME_to_a_long_random_secret
TEAMS_WEBHOOK_SECRET=CHANGE_ME_base64_encoded_key
CORS_ORIGINS=https://your-app.example.com
API_ALLOWED_HOSTS=api.your-app.example.com
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BODY_BYTES=65536
METRICS_TOKEN=CHANGE_ME_metrics_secret
OPENROUTER_API_KEY=CHANGE_ME_openrouter_key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MAX_RETRIES=5
OPENROUTER_TIMEOUT_SECONDS=90
CONVERSATION_MAX_AGE_DAYS=30
