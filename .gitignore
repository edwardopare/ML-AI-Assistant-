# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
env/
.venv/

# Environment / secrets — never commit real credentials
.env
.env.*
.env.example
.env.dev
.env.prod.example
.secrets.baseline

# Runtime data stores (rebuilt by ingestion)
.chromadb/
chroma/
*.json.tmp
scan.json

# Data folder — keep all local inputs, source PDFs, and caches out of version control
data/
data/.gitkeep

# Test and IDE caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
